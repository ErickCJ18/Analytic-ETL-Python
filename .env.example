# Copia este archivo a .env y ajusta los valores reales
DB_DRIVER={ODBC Driver 17 for SQL Server}
DB_SERVER=DATABASE_sERVER
DB_DATABASE=DATABASE_NAME
DB_TRUSTED_CONNECTION=???
# Si DB_TRUSTED_CONNECTION=no, descomenta y completa:
# DB_USER=tu_usuario
# DB_PASSWORD=tu_password

DATA_DIR=data
LOG_DIR=logs
LOG_LEVEL=INFO

# Tareas que se ejecutan en paralelo (dimensiones y hechos). 0 = sin límite
MAX_WORKERS=8
